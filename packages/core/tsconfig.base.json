{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "moduleResolution": "Node10",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "src/assets.ts",
    "src/vite-assets.ts",
    "src/editor.ts",
    "src/controlled.ts",
    "src/react.tsx",
    "src/vue.ts"
  ]
}
